---
import { copy } from '@/lib/copy'

const items = copy.credibility.items
const doubled = [...items, ...items]
---

<div class="ticker-wrap" aria-label="Capabilities">
  <div class="ticker-track">
    {
      doubled.map((item, index) => (
        <span class="ticker-item" aria-hidden={index >= items.length ? 'true' : undefined}>
          {item}
        </span>
      ))
    }
  </div>
</div>
