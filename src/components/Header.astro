---
import Container from '@/components/ui/Container.astro'
import Button from '@/components/ui/Button.astro'
import { copy } from '@/lib/copy'
---

<header class="sticky top-0 z-50 bg-brand-dark/95 backdrop-blur-sm border-b border-white/5">
  <Container>
    <nav aria-label="Main navigation" class="flex items-center justify-between h-16">
      <a
        href="/"
        class="text-xl font-semibold tracking-tight text-white hover:text-gray-200 transition-colors"
      >
        {copy.site.name}
      </a>

      <ul class="hidden md:flex items-center gap-8">
        {
          copy.nav.links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="hidden md:block">
        <Button variant="primary" size="md" href={copy.nav.cta.href}>
          {copy.nav.cta.label}
        </Button>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="md:hidden flex flex-col gap-1.5 p-2 -mr-2 text-white"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation"
      >
        <span class="block w-6 h-0.5 bg-white transition-all"></span>
        <span class="block w-6 h-0.5 bg-white transition-all"></span>
        <span class="block w-4 h-0.5 bg-white transition-all"></span>
      </button>
    </nav>

    <div id="mobile-menu" class="md:hidden border-t border-white/10 py-5 flex-col gap-5">
      <ul class="flex flex-col gap-4">
        {
          copy.nav.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-300 hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button variant="primary" size="md" href={copy.nav.cta.href}>
        {copy.nav.cta.label}
      </Button>
    </div>
  </Container>
</header>

<style is:global>
  #mobile-menu {
    display: none;
  }
  #mobile-menu.open {
    display: flex;
  }
</style>

<script>
  const btn = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open')
    btn.setAttribute('aria-expanded', String(isOpen))
  })
</script>
